    "ActionProposal": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "ActionProposal"
        },
        "schemaVersion": {
          "const": "tse-pilot/0.2"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "actor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "consequence": {
          "const": "C3"
        },
        "expectedEffect": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "precondition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "recoveryLimit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "expiresAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        "binding": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "actionType": {
          "enum": [
            "publish",
            "correct",
            "withdraw"
          ]
        },
        "recoveryFor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            {
              "type": "null"
            }
          ]
        },
        "expectedResourceVersion": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "schemaVersion",
        "id",
        "version",
        "scope",
        "createdAt",
        "actor",
        "target",
        "content",
        "consequence",
        "expectedEffect",
        "precondition",
        "recoveryLimit",
        "expiresAt",
        "binding",
        "actionType",
        "recoveryFor",
        "expectedResourceVersion"
      ],
      "additionalProperties": false
    },
