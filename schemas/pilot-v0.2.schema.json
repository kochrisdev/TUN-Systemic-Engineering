{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tun:engineering:pilot:0.2",
  "title": "TUN local publication and recovery pilot records (experimental)",
  "oneOf": [
    {
      "$ref": "#/$defs/ActionProposal"
    },
    {
      "$ref": "#/$defs/ApprovalDecision"
    },
    {
      "$ref": "#/$defs/AuthorizationDecision"
    },
    {
      "$ref": "#/$defs/ExecutionGrant"
    },
    {
      "$ref": "#/$defs/OperationRecord"
    },
    {
